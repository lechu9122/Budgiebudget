# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and must NEVER be committed.

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Instructions to get these values:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy the values below

# Your Supabase project URL (e.g., https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=https://utddbngkvxcisbfheaat.supabase.co/

# Supabase Anonymous Key (safe for client-side use, respects RLS policies)
# This key is used in the frontend React app
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV0ZGRibmdrdnhjaXNiZmhlYWF0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI4NzMwMDIsImV4cCI6MjA4ODQ0OTAwMn0.sVgsS8Jcsx4ixARys-0StxV3vEa2kruJJxVdl52S5aU

# Supabase Service Role Key (KEEP SECRET! Has admin access, bypasses RLS)
# This key is used in backend/server-side operations only
# NEVER expose this in frontend code or commit to Git
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV0ZGRibmdrdnhjaXNiZmhlYWF0Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3Mjg3MzAwMiwiZXhwIjoyMDg4NDQ5MDAyfQ.T6CDMPXVKNC0tRluKtwqY1ghkKAeIdOKsT2FUMGyRmU

# ==============================================================================
# BACKEND DATABASE CONNECTION
# ==============================================================================
# PostgreSQL connection string for C++ backend (libpqxx)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
#
# LOCAL DEVELOPMENT (default): a PostgreSQL server on this machine.
# Create the database once with `createdb budgie`. On macOS/Homebrew the
# default user is your macOS username with no password.
DATABASE_URL=postgresql://[YOUR-OS-USERNAME]@localhost:5432/budgie
#
# DEPLOYMENT (e.g. Supabase): comment out the local URL above and use a hosted
# connection string instead. Get it from: Settings > Database > Connection String
# Example: postgresql://postgres.[PROJECT]:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Secret used to sign JWTs – use a long, random string in production
JWT_SECRET=By5fj6zCigRXw3cT

# Port the C++ backend listens on (React dev server proxies to this)
PORT=8080

# ==============================================================================
# FRONTEND CONFIGURATION (React)
# ==============================================================================
# For React apps, environment variables must start with REACT_APP_
REACT_APP_SUPABASE_URL=https://utddbngkvxcisbfheaat.supabase.co/
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV0ZGRibmdrdnhjaXNiZmhlYWF0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI4NzMwMDIsImV4cCI6MjA4ODQ0OTAwMn0.sVgsS8Jcsx4ixARys-0StxV3vEa2kruJJxVdl52S5aU
REACT_APP_API_URL=http://localhost:8080

